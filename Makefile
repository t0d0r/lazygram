BIN     := lazygram
PREFIX  ?= $(HOME)/.local
STATE   ?= $(CURDIR)/.state
GOFILES  = $(shell find . -name '*.go' -not -path './.state/*' -not -path './dist/*')
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
DIST_PLATFORMS ?= linux/amd64 linux/arm64 darwin/amd64 darwin/arm64

.PHONY: help build test lint check run demo login smoke embed dist release fmt install uninstall clean purge
.DEFAULT_GOAL := help

help: ## list the targets
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | sed -E 's/^([a-z-]+):.*## (.*)/  \1\t\2/'

build: ## build ./lazygram (carries the registration when "make embed" was run)
	go build -ldflags "-X main.version=$(VERSION)" -o $(BIN) ./cmd/lazygram

test: ## run all tests
	go test ./...

lint: ## gofmt check, go vet, golangci-lint (staticcheck, errcheck, unused), sh -n and shellcheck on install.sh
	@out="$$(gofmt -l $(GOFILES))"; if [ -n "$$out" ]; then echo "gofmt needed:"; echo "$$out"; exit 1; fi
	go vet ./...
	@if command -v golangci-lint >/dev/null 2>&1; then golangci-lint run ./...; else echo "golangci-lint not installed, skipped"; fi
	sh -n install.sh
	@if command -v shellcheck >/dev/null 2>&1; then shellcheck -s sh install.sh; else echo "shellcheck not installed, skipped"; fi

check: lint test ## lint and test; must pass before a commit

run: build ## build and start with the linked Telegram account (state in .state/)
	./$(BIN) -data $(STATE)

demo: build ## build and start with invented offline data
	./$(BIN) -data $(STATE) demo

login: build ## link a Telegram account by QR code (state in .state/)
	./$(BIN) -data $(STATE) login

smoke: build ## non-interactive: sync the demo once, print one screen
	./$(BIN) -data $(STATE) -smoke demo

# The values are read by the shell from its environment ($$VAR), never
# expanded into the recipe text, and must be digits / hex: no quoting or
# injection is possible and nothing is echoed.
embed: ## write the git-ignored cmd/lazygram/app_local.go from TG_API_ID/TG_API_HASH in the environment, like nchat's built-in registration
	@test -n "$$TG_API_ID" && test -n "$$TG_API_HASH" || { echo "TG_API_ID and TG_API_HASH must be set in the environment (for example by direnv from .envrc)"; exit 1; }
	@case "$$TG_API_ID" in *[!0-9]*) echo "TG_API_ID must be digits only"; exit 1;; esac
	@case "$$TG_API_HASH" in *[!0-9a-fA-F]*) echo "TG_API_HASH must be hexadecimal"; exit 1;; esac
	@test "$${#TG_API_HASH}" -ge 16 || { echo "TG_API_HASH is too short"; exit 1; }
	@umask 077; printf '//go:build !release\n\npackage main\n\n// Generated by "make embed" and git-ignored. Carries this build'"'"'s Telegram\n// application registration, like nchat'"'"'s built-in one. Regenerate to change.\n// Excluded from release builds by the build tag above.\nfunc init() { buildAppID, buildAppHash = "%s", "%s" }\n' "$$TG_API_ID" "$$TG_API_HASH" > cmd/lazygram/app_local.go
	@chmod 600 cmd/lazygram/app_local.go
	@git check-ignore -q cmd/lazygram/app_local.go || { echo "refusing: app_local.go is not git-ignored"; rm -f cmd/lazygram/app_local.go; exit 1; }
	@echo "wrote cmd/lazygram/app_local.go (git-ignored); make build now carries the registration"

# Release builds use -tags release so the git-ignored app_local.go (a
# personal registration) can never end up in a published binary.
dist: ## build release tarballs, install.sh and SHA256SUMS into dist/ for every DIST_PLATFORMS entry
	@set -e; rm -rf dist; mkdir -p dist; \
	files="$$(go list -tags release -f '{{join .GoFiles " "}}' ./cmd/lazygram)"; \
	case " $$files " in *app_local.go*) echo "dist: app_local.go would be built in; aborting"; exit 1;; esac; \
	case "$$(tar --version)" in \
		*bsdtar*) own="--uid 0 --gid 0 --uname root --gname root";; \
		*) own="--owner=0 --group=0 --numeric-owner";; \
	esac; \
	for p in $(DIST_PLATFORMS); do \
		os=$${p%/*}; arch=$${p#*/}; name=lazygram-$(VERSION)-$$os-$$arch; \
		mkdir dist/$$name; \
		GOOS=$$os GOARCH=$$arch CGO_ENABLED=0 go build -trimpath -tags release \
			-ldflags "-s -w -X main.version=$(VERSION)" -o dist/$$name/lazygram ./cmd/lazygram; \
		cp LICENSE README.md dist/$$name/; \
		COPYFILE_DISABLE=1 tar $$own -czf dist/$$name.tar.gz -C dist $$name; \
		rm -rf dist/$$name; \
	done; \
	cp install.sh dist/install.sh; chmod 0644 dist/install.sh; \
	cd dist; \
	if command -v sha256sum >/dev/null; then sha256sum *.tar.gz install.sh; else shasum -a 256 *.tar.gz install.sh; fi > SHA256SUMS; \
	cat SHA256SUMS

release: ## publish dist/ as the GitHub release for the current tag (needs gh and a clean vX.Y.Z tag)
	@echo "$(VERSION)" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$$' || { echo "release: HEAD must be at a clean vX.Y.Z tag, got $(VERSION)"; exit 1; }
	@command -v gh >/dev/null || { echo "release: gh is required"; exit 1; }
	@test -f dist/SHA256SUMS || { echo "release: run make dist first"; exit 1; }
	@test -f dist/install.sh || { echo "release: dist/install.sh missing; run make dist"; exit 1; }
	gh release create $(VERSION) dist/*.tar.gz dist/install.sh dist/SHA256SUMS --title "lazygram $(VERSION)" --generate-notes

fmt: ## format in place
	gofmt -w $(GOFILES)

install: build ## install to $(PREFIX)/bin
	install -d $(PREFIX)/bin
	install -m 0755 $(BIN) $(PREFIX)/bin/$(BIN)

uninstall: ## remove from $(PREFIX)/bin
	rm -f $(PREFIX)/bin/$(BIN)

clean: ## remove build output (keeps .state/: session, registration, cache)
	rm -rf $(BIN) dist

purge: ## remove .state/: the linked session, stored registration and message cache
	rm -rf .state
