BIN     := lazygram
PREFIX  ?= $(HOME)/.local
STATE   ?= $(CURDIR)/.state
GOFILES  = $(shell find . -name '*.go' -not -path './.state/*')

# Optional: embed your own Telegram application registration so a personal
# build never asks for it. Never commit these values.
TG_API_ID   ?=
TG_API_HASH ?=
LDFLAGS      = -X main.buildAppID=$(TG_API_ID) -X main.buildAppHash=$(TG_API_HASH)

.PHONY: help build test lint check run demo login smoke embed fmt install uninstall clean
.DEFAULT_GOAL := help

help: ## list the targets
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | sed -E 's/^([a-z-]+):.*## (.*)/  \1\t\2/'

build: ## build ./lazygram
	go build -ldflags '$(LDFLAGS)' -o $(BIN) ./cmd/lazygram

test: ## run all tests
	go test ./...

lint: ## gofmt check, go vet, golangci-lint (staticcheck, errcheck, unused)
	@out="$$(gofmt -l $(GOFILES))"; if [ -n "$$out" ]; then echo "gofmt needed:"; echo "$$out"; exit 1; fi
	go vet ./...
	@if command -v golangci-lint >/dev/null 2>&1; then golangci-lint run ./...; else echo "golangci-lint not installed, skipped"; fi

check: lint test ## lint and test; must pass before a commit

run: build ## build and start with the linked Telegram account (state in .state/)
	./$(BIN) -data $(STATE)

demo: build ## build and start with invented offline data
	./$(BIN) -data $(STATE) demo

login: build ## link a Telegram account by QR code (state in .state/)
	./$(BIN) -data $(STATE) login

smoke: build ## non-interactive: sync the demo once, print one screen
	./$(BIN) -data $(STATE) -smoke demo

embed: ## write the git-ignored cmd/lazygram/app_local.go from TG_API_ID/TG_API_HASH, like nchat's built-in registration
	@test -n "$(TG_API_ID)" && test -n "$(TG_API_HASH)" || { echo "TG_API_ID and TG_API_HASH must be set (for example by direnv from .envrc)"; exit 1; }
	@printf 'package main\n\n// Generated by "make embed" and git-ignored. Carries this build'"'"'s Telegram\n// application registration, like nchat'"'"'s built-in one. Regenerate to change.\nfunc init() { buildAppID, buildAppHash = "%s", "%s" }\n' "$(TG_API_ID)" "$(TG_API_HASH)" > cmd/lazygram/app_local.go
	@chmod 600 cmd/lazygram/app_local.go
	@git check-ignore -q cmd/lazygram/app_local.go || { echo "refusing: app_local.go is not git-ignored"; rm -f cmd/lazygram/app_local.go; exit 1; }
	@echo "wrote cmd/lazygram/app_local.go (git-ignored); make build now carries the registration"

fmt: ## format in place
	gofmt -w $(GOFILES)

install: build ## install to $(PREFIX)/bin
	install -d $(PREFIX)/bin
	install -m 0755 $(BIN) $(PREFIX)/bin/$(BIN)

uninstall: ## remove from $(PREFIX)/bin
	rm -f $(PREFIX)/bin/$(BIN)

clean: ## remove build output and local demo state
	rm -rf $(BIN) .state
